# Prismatic Engine public/local defaults
# Copy to .env and fill only the local settings you need.
# Never commit .env or real credentials.

# --- Runtime state ---
PRISMATIC_STATE_DIR=./prismatic_state
PRISMATIC_PLUGIN_JOBS_STATE=./prismatic_state/plugin_jobs.json
PRISMATIC_PLUGIN_ARTIFACTS_STATE=./prismatic_state/plugin_artifacts.json
PRISMATIC_BUS_DB=./prismatic_state/event_log.sqlite
PRISMATIC_CURATOR_DB=./prismatic_state/curator.sqlite
PRISMATIC_DIGEST_DIR=./prismatic_state/digests

# --- Gateway ---
PRISMATIC_HOST=127.0.0.1
PRISMATIC_PORT=9000
PRISMATIC_ALLOWED_IPS=127.0.0.1,::1

# --- Local development toggles ---
PRISMATIC_LOG_LEVEL=INFO
PRISMATIC_PUBLIC_DEMO_MODE=1

# Optional integrations such as GitHub, Linear, model providers, and PWP
# credentials are intentionally not filled here. Export those values in
# your shell/secret manager only when you intentionally enable the matching
# integration. Keep committed examples free of real credential material.

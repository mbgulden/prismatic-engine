# Prismatic Engine Deploy Receiver — systemd unit template (WS3).
#
# Rendered by pe.deploy.install.render_template(): UPPER_SNAKE tokens in
# double braces are substituted; lines that render empty are dropped.
# This template is
# modeled on the production receiver unit (user scope, like today's
# webtop-hermes receiver). Production units on existing boxes are
# grandfathered -- this template is the source of truth for NEW installs.
[Unit]
Description=Prismatic Engine Deploy Receiver (port {{RECEIVER_PORT}}, HMAC-signed trigger)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
{{USER_DIRECTIVE}}
WorkingDirectory={{STATE_DIR}}
ExecStart={{RECEIVER_VENV}}/bin/python -m pe.deploy.receiver
EnvironmentFile={{ENV_FILE}}
Environment=PRISMATIC_HOME={{HOME_DIR}}
Environment=PYTHONUNBUFFERED=1
Environment=PRISMATIC_DEPLOY_SOURCE_REPO={{DEPLOY_SOURCE_REPO}}
Restart=always
RestartSec=10
StandardOutput=append:{{STATE_DIR}}/logs/deploy-receiver.log
StandardError=append:{{STATE_DIR}}/logs/deploy-receiver.log

[Install]
WantedBy={{WANTED_BY}}

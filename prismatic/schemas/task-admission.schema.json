{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismatic-engine.local/schemas/task-admission.schema.json",
  "title": "Prismatic dashboard task admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "task_id",
    "base_commit",
    "base_tree",
    "task_file",
    "task_file_sha256",
    "producer_identity",
    "worktree",
    "writer_cap",
    "idempotency_key",
    "created_at",
    "status"
  ],
  "properties": {
    "version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,15}-[1-9][0-9]{0,9}$", "maxLength": 32},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "task_file": {"type": "string", "minLength": 1, "maxLength": 512},
    "task_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer_identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "worktree": {"type": "string", "minLength": 1, "maxLength": 1024},
    "writer_cap": {"type": "integer", "const": 1},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{31,127}$"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "status": {"const": "admitted"}
  }
}

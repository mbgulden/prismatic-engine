{
  "schema_version": "1.0.0",
  "name": "hde-funnel-fixture",
  "owner": "ned",
  "site_slug": "hd-engine-fixture",
  "domain": "humandesignengine.com.test",
  "description": "Lightweight canonical collection used by the pwp.publish_kpi_tracker tests. Includes a derived, a ga4, and a verifier metric with mixed formats.",
  "tracking_property": "G-Q6TPL08VM7",
  "expected_data_layer_events": ["hde_chart_generated", "hde_daily_work_cta_clicked"],
  "ga4_recommended_events": ["select_item", "begin_checkout", "purchase"],
  "metrics": {
    "funnel_top.free_chart_generated_total": {
      "id": "free_chart_generated_total",
      "label": "Charts generated",
      "source": "ga4",
      "event": "hde_chart_generated",
      "front_of_card": true
    },
    "funnel_buy_report.purchase_total": {
      "id": "purchase_total",
      "label": "Purchases",
      "source": "stripe",
      "event": "checkout.session.completed",
      "filter": "metadata.funnel == report_checkout",
      "front_of_card": true
    },
    "funnel_buy_report.buy_report_revenue_usd": {
      "id": "buy_report_revenue_usd",
      "label": "Revenue USD",
      "source": "stripe",
      "field": "amount_total",
      "filter": "event == checkout.session.completed AND metadata.funnel == report_checkout",
      "front_of_card": true
    },
    "funnel_buy_report.buy_report_conversion_rate": {
      "id": "buy_report_conversion_rate",
      "label": "Conversion rate",
      "source": "derived",
      "formula": "buy_report_purchase_total / buy_report_page_view",
      "format": "percent"
    },
    "site_hygiene.sitemap_coverage_pct": {
      "id": "sitemap_coverage_pct",
      "label": "Sitemap GA coverage",
      "source": "verifier",
      "format": "percent"
    }
  },
  "share_targets": {
    "google_sheet_id_env": "HDE_KPI_SHEET_ID",
    "credential_file_env": "HDE_GOOGLE_SERVICE_ACCOUNT_JSON",
    "email_to_env": "HDE_KPI_EMAIL_TO",
    "email_to_default": "mbgulden@gmail.com",
    "dashboard_route": "/pwp/kpi/",
    "dashboard_section_label": "HDE KPI tracker"
  },
  "delivery_cadence": { "daily": {"kind": "daily"}, "weekly": {"kind": "weekly"}, "monthly": {"kind": "monthly"} }
}

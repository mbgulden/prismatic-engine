{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prismatic.dev/pwp/theme.schema.json",
  "title": "PWP Theme Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "$schema",
    "id",
    "name",
    "version",
    "engineCompatibility",
    "framework",
    "entrypoints",
    "modules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^pwp\\.theme\\.[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "engineCompatibility": {
      "type": "string",
      "minLength": 1
    },
    "framework": {
      "const": "astro"
    },
    "editableWith": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entrypoints": {
      "type": "object",
      "required": [
        "tokens",
        "css",
        "layout",
        "components",
        "contentSchema",
        "emdashMap"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "verification": {
      "type": "object"
    }
  }
}

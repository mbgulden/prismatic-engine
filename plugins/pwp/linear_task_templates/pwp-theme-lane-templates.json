      "agentLabel": "agent:kai-content",
      "titleTemplate": "[PWP Theme {phase}] Plan content/module strategy: {site_or_theme}",
      "descriptionTemplate": [
        "## Scope",
        "Map the client profile and content brief into a route manifest, page/module sequence, locked claims, editable fields, and handoff notes for implementation.",
        "",
        "## Required inputs",
        "{{inputs}}",
        "",
        "## Files/contracts to use",
        "{{contracts}}",
        "",
        "## Expected outputs",
        "{{outputs}}",
        "",
        "## Verification evidence required",
        "{{verification}}",
        "",
        "## Build policy",
        "Keep this issue in Todo and do not add dispatch:ready until Michael explicitly starts the build process. Attach verifier artifacts before Done."
      ],
      "defaultLabels": [
        "agent:kai-content",
        "plugin:pwp",
        "prismatic-engine",
        "pwp-theme",
        "Feature"
      ],
      "forbiddenLabelsBeforeHumanStart": [
        "dispatch:ready"
      ],
      "inputArtifacts": [
        "client profile or intake/distill artifact",
        "selected theme family and required modules",
        "PWP theme/module/token/EmDash contracts",
        "acceptance criteria from the parent phase output",
        "OKF intake/distill records",
        "regulated-claim constraints"
      ],
      "allowedFileGlobs": [
        "plugins/pwp/**",
        "okf/standards/pwp-*.md"
      ],
      "blockedFileGlobs": [
        "content/**",
        "assets/**",
        "designs/**",
        "research/**",
        "active-oahu/**"
      ],
      "outputArtifacts": [
        "route/module plan",
        "content safety notes",
        "EmDash editable-field plan",
        "SEO/schema handoff brief"
      ],
      "verificationCommands": [
        "schema/fixture check for route/module plan",
        "content-safety lint evidence"
      ],
      "completionChecklist": [
        "Issue references exact files/contracts touched",
        "Docs updated in the same branch",
        "Verifier output or artifact is attached/commented",
        "No dispatch:ready label was added before Michael's build-start signal",
        "Every page has a module sequence using known PWP module ids"

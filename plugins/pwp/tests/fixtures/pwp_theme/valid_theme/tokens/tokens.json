{
  "color": {
    "background": {
      "page": {
        "$value": "#ffffff",
        "$type": "color"
      }
    },
    "text": {
      "primary": {
        "$value": "#111827",
        "$type": "color"
      }
    }
  },
  "font": {
    "family": {
      "body": {
        "$value": "Inter, sans-serif",
        "$type": "fontFamily"
      }
    }
  },
  "space": {
    "md": {
      "$value": "1rem",
      "$type": "dimension"
    }
  },
  "size": {
    "container": {
      "$value": "72rem",
      "$type": "dimension"
    }
  },
  "radius": {
    "md": {
      "$value": "0.5rem",
      "$type": "dimension"
    }
  },
  "shadow": {

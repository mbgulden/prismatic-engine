      "$value": "0 1px 2px rgb(0 0 0 / 0.08)",
      "$type": "shadow"
    }
  },
  "motion": {
    "fast": {
      "$value": "150ms",
      "$type": "duration"
    }
  },
  "breakpoint": {
    "md": {
      "$value": "768px",
      "$type": "dimension"
    }
  },

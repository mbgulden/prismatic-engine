{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prismatic.dev/pwp/module.schema.json",
  "title": "PWP Module Contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "component",
    "propsSchema",
    "editableFields",
    "variants"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "component": {
      "type": "string",
      "minLength": 1
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "propsSchema": {
      "type": "string",
      "minLength": 1
    },
    "editableFields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "a11yRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contentSafetyRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

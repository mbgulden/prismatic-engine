{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prismatic.dev/pwp/emdash-map.schema.json",
  "title": "PWP EmDash Editable Field Map",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contentType",
    "blocks"
  ],
  "properties": {
    "contentType": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "blockId",
          "component",
          "fields"
        ],
        "properties": {
          "blockId": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "object",
            "minProperties": 1
          },
          "lockedFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "lockedFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

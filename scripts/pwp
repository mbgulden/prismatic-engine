#!/usr/bin/env python3
"""Small PWP command shim for repo-local operations."""
from __future__ import annotations

import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from plugins.pwp.theme_validator import main as theme_validate_main  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if len(args) >= 2 and args[0] == "theme" and args[1] == "validate":
        return theme_validate_main(args[2:])
    print("Usage: pwp theme validate <path> [--json]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
